# Скопируйте в .env: docker compose подхватит значения автоматически.

# --- общие ---
WORKER_TOKEN=dev-worker-token-change-me

# --- api ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/jobs
STALE_AFTER_SECONDS=600
MAX_ATTEMPTS=3
REAPER_INTERVAL_SECONDS=30
REAPER_ENABLED=true
LOG_LEVEL=INFO

# --- воркер ---
API_URL=http://api:8000
POLL_INTERVAL=1.0
FAIL_RATE=0.1
# WORKER_ID задаётся для каждого воркера в docker-compose.yml (по умолчанию — hostname)
